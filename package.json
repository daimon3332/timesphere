{
  "name": "timesphere",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "fetch:sources": "bash scripts/fetch-sources.sh",
    "build:data": "node scripts/build-data.mjs",
    "deploy": "npm run lint && npm test && npm run build && npx wrangler pages deploy dist --project-name=timesphere --branch=main --commit-dirty=true"
  },
  "dependencies": {
    "maplibre-gl": "6.6.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/geojson": "7946.0.16",
    "@types/node": "^24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "5.2.0",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "6.1.1",
    "globals": "16.5.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.69.0",
    "vite": "7.3.6",
    "vitest": "3.2.7"
  }
}
